#########################################################################


set -o pipefail


_swocserver()
{
	local cur OPTS

	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"

	OPTS="-a -b -c -d -e -h -r -s -u -V -w"
	OPTS+=" --allow --block --disallow --end-daemon --help --release"
	OPTS+=" --reload-config --status --unblock --version --wait"
	# shellcheck disable=SC2207  # This is _the_ bash completion
	# pattern, so leave it be.
	COMPREPLY=( $(compgen -W "${OPTS[*]}" -- "$cur") )

	return 0
}
complete -F _swocserver swocserver

