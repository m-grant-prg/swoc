#! @envlocation@ bash

set -e
cd "$(dirname "$0")"
testdir=$(pwd)

# srcdir is set in the TEST directive but not otherwise. So running the
# run-tests be it as make check or make distcheck works. This is needed because
# the directory structure is different during make distcheck.
if [[ -z $srcdir ]]; then
	cliheaders="-I../../../../../../../src/prg/c/inc"
	cliheaders+=" -I../../../../../../../src/prg/c/inc-tmp"
	cliheaders+=" -I../../../../../../../src/prg/c/inc-tmp/libmgec"
	cliheaders+=" -I../../../../../../../src/prg/c/inc-tmp/libmgesysutils"
	headers=$(find ../../../../../../../src -name inc-tmp -prune \
		-o -name "*.h" -print)
else
	cliheaders="-I$(realpath "@abstopsrcdir@")/src/prg/c/inc"
	cliheaders+=" -I$(realpath "@abstopsrcdir@")/src/prg/c/inc-tmp"
	cliheaders+=" -I$(realpath "@abstopsrcdir@")/src/prg/c/inc-tmp/libmgec"
	cliheaders+=" -I$(realpath "@abstopsrcdir@")"
	cliheaders+="/src/prg/c/inc-tmp/libmgesysutils"
	headers=$(find "$(realpath "@abstopsrcdir@")/src" -name inc-tmp -prune \
		-o -name "*.h" -print)
fi
for headerpath in $headers; do
	header=${headerpath##*/}
	# shellcheck disable=SC2086 # Header file list args needs word splitting
	@CC@ $headerpath $cliheaders -Wall -Wextra -o $testdir/$header.gch
done
cd -

